{
  "name": "millsaathi",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev:worker",
    "dev:worker": "wrangler dev",
    "dev:web": "npm --workspace @millsaathi/web run dev",
    "dev:api": "npm --workspace @millsaathi/api run dev",
    "build:web": "npm --workspace @millsaathi/web run build",
    "check:web": "npm --workspace @millsaathi/web run check",
    "check:api": "npm --workspace @millsaathi/api run check",
    "check:all": "npm run check && npm run check:web && npm run check:api",
    "build:seo": "node scripts/build-seo.mjs",
    "deploy": "npm run build:seo && wrangler deploy",
    "types": "wrangler types",
    "check": "tsc --noEmit",
    "test:smoke": "node scripts/smoke-local.mjs",
    "db:migrate:local": "wrangler d1 migrations apply millsaathi --local",
    "db:migrate:remote": "wrangler d1 migrations apply millsaathi --remote",
    "db:seed:local": "wrangler d1 execute millsaathi --local --file=./db/seed-demo.sql"
  },
  "dependencies": {
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
