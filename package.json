{
  "name": "millsaathi",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:clean": "node -e \"require('node:fs').rmSync('apps/web/.next',{recursive:true,force:true})\" && node scripts/dev.mjs",
    "dev:worker": "wrangler dev",
    "dev:worker:static": "npm run build:worker && wrangler dev",
    "dev:web": "npm --workspace @millsaathi/web run dev",
    "build:web": "npm --workspace @millsaathi/web run build",
    "build:worker": "npm run build:web && node scripts/build-worker-web.mjs",
    "check:web": "npm --workspace @millsaathi/web run check",
    "check:all": "npm run check && npm run check:web",
    "build:seo": "node scripts/build-seo.mjs",
    "deploy": "npm run build:seo && npm run build:worker && wrangler deploy",
    "types": "wrangler types",
    "check": "tsc --noEmit",
    "test:smoke": "node scripts/smoke-local.mjs",
    "test:authz": "node scripts/authz-tests.mjs",
    "test:processing-input": "node --experimental-strip-types scripts/processing-input-tests.mjs",
    "test:quantity": "node --experimental-strip-types scripts/quantity-tests.mjs",
    "razorpay:plans": "node scripts/razorpay-create-plans.mjs",
    "db:migrate:local": "wrangler d1 migrations apply millsaathi --local",
    "db:migrate:remote": "wrangler d1 migrations apply millsaathi --remote",
    "db:seed:local": "wrangler d1 execute millsaathi --local --file=./db/seed-demo.sql"
  },
  "dependencies": {
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
